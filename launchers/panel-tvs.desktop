[Desktop Entry]
Type=Application
Name=YouTube en TVs
Comment=Panel de control de YouTube en los TVs (buscar, listas, pausa, volumen, pantalla completa)
Exec=bash -c "export PATH=\$HOME/.local/bin:\$PATH; (curl -s -m 2 -o /dev/null http://127.0.0.1:8765/api/state || { nohup tvpanel > /tmp/tvpanel.log 2>&1 & sleep 2; }); xdg-open http://127.0.0.1:8765/"
Icon=preferences-system-sound
Terminal=false
Categories=AudioVideo;Video;
Keywords=youtube;tv;kiosko;panel;control;television;
StartupWMClass=tvpanel
Actions=search;kiosk;

[Desktop Action search]
Name=Buscar en YouTube
Exec=bash -c "export PATH=\$HOME/.local/bin:\$PATH; (curl -s -m 2 -o /dev/null http://127.0.0.1:8765/api/state || { nohup tvpanel > /tmp/tvpanel.log 2>&1 & sleep 2; }); xdg-open http://127.0.0.1:8765/"

[Desktop Action kiosk]
Name=Arrancar kiosko TV
Exec=bash -c "export PATH=\$HOME/.local/bin:\$PATH; tvkiosk"
