#!/bin/bash
# tvkiosk -> abre (o reutiliza) Chrome kiosko fullscreen en la pantalla de los TVs
PORT=9222
PROF="$HOME/.config/tvchrome"
CHROME=$(command -v google-chrome || command -v chromium || command -v chromium-browser || true)
[ -z "$CHROME" ] && { echo "ERROR: no hay google-chrome/chromium instalado"; exit 1; }

# Entorno grafico: si lo arranca tvpanel como servicio de systemd no hay
# DISPLAY/XAUTHORITY y Chrome con --ozone-platform=x11 muere al instante con
# "Missing X server or $DISPLAY". Se descubre la sesion Wayland/X11 propia.
if ! xrandr >/dev/null 2>&1; then
  RT="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  for a in "$RT"/.mutter-Xwaylandauth.* "$HOME"/.Xauthority; do
    if [ -r "$a" ]; then export XAUTHORITY="$a"; break; fi
  done
  for n in $(ls /tmp/.X11-unix 2>/dev/null | sed -n 's/^X\([0-9]\+\)$/\1/p' | sort -rn); do
    if DISPLAY=":$n" xrandr >/dev/null 2>&1; then export DISPLAY=":$n"; break; fi
  done
fi
xrandr >/dev/null 2>&1 || { echo "ERROR: no hay servidor X (XWayland) disponible"; exit 1; }

GEO=$(xrandr | sed -n 's/^HDMI-1 connected.* \([0-9]*x[0-9]*\)+\([0-9]*\)+\([0-9]*\).*/\1 \2 \3/p' | head -1)
if [ -z "$GEO" ]; then GEO="1680x1050 1600 0"; fi
SIZE=${GEO%% *}; REST=${GEO#* }; X=${REST%% *}; Y=${REST##* }
W=${SIZE%x*}; H=${SIZE#*x}

# Chrome puede ignorar --window-position/--window-size al restaurar la
# sesión del perfil. Fuerza la geometría por CDP en ambos caminos.
enforce_bounds() {
python3 - "$X" "$Y" "$W" "$H" <<'PYEOF'
import json, sys, urllib.request
from websocket import create_connection

x, y, w, h = map(int, sys.argv[1:5])
try:
    tabs = json.load(urllib.request.urlopen('http://127.0.0.1:9222/json/list', timeout=4))
    pages = [t for t in tabs if t.get('type') == 'page']
    if not pages:
        sys.exit(0)
    ws = create_connection(pages[0]['webSocketDebuggerUrl'], timeout=8)
    def rpc(i, method, params=None):
        ws.send(json.dumps({'id': i, 'method': method, 'params': params or {}}))
        while True:
            m = json.loads(ws.recv())
            if m.get('id') == i:
                return m.get('result')
    wid = rpc(1, 'Browser.getWindowForTarget')['windowId']
    rpc(2, 'Browser.setWindowBounds', {'windowId': wid, 'bounds': {
        'left': x, 'top': y, 'width': w, 'height': h, 'windowState': 'normal'}})
except Exception as e:
    print(f'aviso: no se pudo forzar la geometría del kiosko ({e})')
PYEOF
}

mkdir -p "$PROF"

# Extensiones anti-ads (uBlock Origin Lite MV3, SponsorBlock)
# Chrome 137+ ignora --load-extension en builds oficiales: se cargan por
# CDP con Extensions.loadUnpacked una vez el puerto responde.
EXT_DIR="$PROF/extensions"
EXT_PATHS=""
for d in ublocklite sponsorblock; do
  [ -f "$EXT_DIR/$d/manifest.json" ] && EXT_PATHS="$EXT_PATHS $EXT_DIR/$d"
done

load_extensions() {
[ -z "$EXT_PATHS" ] && return 0
EXT_PATHS="$EXT_PATHS" python3 - <<'PYEOF'
import json, os, sys, urllib.request
from websocket import create_connection
try:
    ver = json.load(urllib.request.urlopen('http://127.0.0.1:9222/json/version', timeout=4))
    ws = create_connection(ver['webSocketDebuggerUrl'], timeout=8)
    for i, path in enumerate(os.environ['EXT_PATHS'].split(), 1):
        ws.send(json.dumps({'id': i, 'method': 'Extensions.loadUnpacked',
                            'params': {'path': path}}))
        while True:
            m = json.loads(ws.recv())
            if m.get('id') == i:
                if 'error' in m:
                    print(f'aviso: no se pudo cargar {path} ({m["error"].get("message","")})')
                break
except Exception as e:
    print(f'aviso: no se pudieron cargar las extensiones ({e})')
PYEOF
}

if curl -s "http://127.0.0.1:$PORT/json/version" >/dev/null 2>&1; then
  enforce_bounds
  load_extensions
  echo "kiosko ya en marcha (puerto $PORT)"
  exit 0
fi

nohup "$CHROME" \
  --user-data-dir="$PROF" \
  --ozone-platform=x11 \
  --remote-debugging-port=$PORT '--remote-allow-origins=*' \
  --window-position=$X,$Y --window-size=$SIZE \
  --no-first-run --no-default-browser-check \
  --noerrdialogs --disable-features=Translate \
  --app=https://www.youtube.com \
  >/tmp/tvkiosk.log 2>&1 &
echo "$!" > /tmp/tvkiosk.pid
echo "kiosko arrancando en la TV ($SIZE@$X,$Y, pid $(cat /tmp/tvkiosk.pid))"
READY=""
for i in $(seq 1 15); do
  if curl -s "http://127.0.0.1:$PORT/json/version" >/dev/null 2>&1; then READY=1; break; fi
  sleep 1
done
if [ -n "$READY" ]; then
  enforce_bounds
  load_extensions
  echo "listo ($i s)"
else
  echo "aviso: no se pudo confirmar el puerto en 15 s (revisa /tmp/tvkiosk.log)"
fi