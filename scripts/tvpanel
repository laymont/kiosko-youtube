#!/usr/bin/env python3
# tvpanel - panel web de control de los TVs (monitor principal)
#   sirve en http://127.0.0.1:8765  y usa los mismos scripts/estado que la terminal
import json
import os
import subprocess
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

BIN = os.path.dirname(os.path.realpath(__file__))
YTDL = os.path.join(BIN, 'yt-dlp')
TVCDP = os.path.join(BIN, 'tvcdp.py')
TVKIOSK = os.path.join(BIN, 'tvkiosk')
QUEUE = '/tmp/tvqueue.txt'
CUR = '/tmp/tvcur'
META = '/tmp/tvmeta.json'
FULL = '/tmp/tvfull'
LAST = {'q': None}
LASTQ_FILE = '/tmp/tvlastq.txt'

# Favoritos persistentes
FAVORITES = os.path.join(os.path.expanduser('~'), '.config', 'tvchrome', 'favorites.json')
STATE_LOCK = threading.Lock()

def read_favorites():
    try:
        data = json.load(open(FAVORITES))
        rows = data.get('rows', []) if isinstance(data, dict) else data
        out = []
        for f in rows:
            if isinstance(f, str):
                out.append({'vid': f, 'title': ''})
            elif isinstance(f, dict) and f.get('vid'):
                out.append({'vid': f['vid'], 'title': f.get('title', '')})
        return out
    except Exception:
        return []

def write_favorites(rows):
    with open(FAVORITES, 'w') as f:
        json.dump({'rows': rows}, f)

# Cargar favoritos al inicio
if not os.path.exists(FAVORITES):
    write_favorites([])

# Añadir favorito
def do_add_favorite(vid, title=''):
    with STATE_LOCK:
        favorites = read_favorites()
        if vid not in [f['vid'] for f in favorites]:
            favorites.append({'vid': vid, 'title': title})
            write_favorites(favorites)
            return {'ok': True, 'count': len(favorites)}
    return {'error': 'ya es favorito'}

# Eliminar favorito
def do_remove_favorite(vid):
    with STATE_LOCK:
        favorites = read_favorites()
        favorites = [f for f in favorites if f['vid'] != vid]
        write_favorites(favorites)
        return {'ok': True, 'count': len(favorites)}

# Verificar si es favorito
def is_favorite(vid):
    with STATE_LOCK:
        favorites = read_favorites()
        return any(f['vid'] == vid for f in favorites)


def sh(*args, timeout=60):
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return r.returncode == 0, r.stdout.strip(), r.stderr.strip()
    except Exception as e:
        return False, '', str(e)


def read_entries():
    out = []
    try:
        with open(QUEUE) as f:
            for line in f:
                line = line.rstrip('\n')
                if not line or '\t' not in line:
                    continue
                vid, title = line.split('\t', 1)
                out.append({'vid': vid, 'title': title})
    except FileNotFoundError:
        pass
    return out


def cur_index():
    try:
        return int(open(CUR).read().strip() or 1)
    except Exception:
        return 1


def read_meta():
    try:
        return json.load(open(META)).get('rows', [])
    except Exception:
        return []


def write_meta(rows):
    with open(META, 'w') as f:
        json.dump({'rows': rows}, f)


def fmt_dur(s):
    try:
        s = int(s)
        return f'{s // 60}:{s % 60:02d}'
    except Exception:
        return ''


def _playback_state():
    """Devuelve 'playing', 'paused' o '' si no se puede saber."""
    ok, out, _ = sh(TVCDP, 'eval',
                    'document.querySelector("video")?'
                    '(document.querySelector("video").paused?"paused":"playing"):""',
                    timeout=8)
    if ok and out.strip() in ('playing', 'paused'):
        return out.strip()
    return ''


def state():
    if os.path.exists(TVCDP):
        ok, out, _ = sh(TVCDP, 'status')
        on = 'OK' in out
    else:
        on = False
    title = url = ''
    if on:
        try:
            import urllib.request
            data = json.load(urllib.request.urlopen('http://127.0.0.1:9222/json/list', timeout=3))
            for t in data:
                if t.get('type') == 'page':
                    title = t.get('title', '')
                    url = t.get('url', '')
                    break
        except Exception:
            pass
    full = False
    playback = ''
    if on:
        try:
            full = _detect_full()
        except Exception:
            pass
        try:
            playback = _playback_state()
        except Exception:
            pass
    rows = read_meta()
    if not rows:
        for r in read_entries():
            rows.append({'vid': r['vid'], 'title': r['title']})
    cur = cur_index()
    entries = []
    for i, r in enumerate(rows, 1):
        vid = r.get('vid', '')
        entries.append({
            'n': i,
            'vid': vid,
            'title': r.get('title', ''),
            'channel': r.get('channel', ''),
            'duration': r.get('duration', ''),
            'thumb': r.get('thumb') or f'https://i.ytimg.com/vi/{vid}/mqdefault.jpg',
            'cur': i == cur,
        })
    favs = read_favorites()
    return {
        'on': on,
        'title': title,
        'url': url,
        'full': full,
        'playback': playback,
        'cur': cur,
        'total': len(entries),
        'favorites_count': len(favs),
        'entries': entries,
        'favorites': favs,
    }


def _load_last_q():
    try:
        return open(LASTQ_FILE).read().strip() or None
    except Exception:
        return None


def _save_last_q(q):
    try:
        with open(LASTQ_FILE, 'w') as f:
            f.write(q)
    except Exception:
        pass


def do_search(q, append=False):
    with STATE_LOCK:
        if append:
            old = len(read_meta()) or len(read_entries())
        else:
            old = 0
        if not append:
            LAST['q'] = q
            _save_last_q(q)
        ok, out, err = sh(YTDL, '--no-warnings', '-J',
                          f'ytsearch5:{q}', timeout=50)
        if not ok:
            return {'error': err or 'busqueda fallida'}
        data = json.loads(out)
        rows = []
        n2 = []
        for e in data.get('entries', []):
            if not e:
                continue
            url = e.get('url') or e.get('webpage_url') or ''
            vid = url.split('v=')[-1].split('&')[0] if 'v=' in url else url
            if not vid:
                continue
            t = e.get('title') or ''
            rows.append({'vid': vid,
                         'title': t,
                         'channel': e.get('channel') or '',
                         'duration': fmt_dur(e.get('duration')),
                         'thumb': f'https://i.ytimg.com/vi/{vid}/mqdefault.jpg'})
            n2.append(f'{vid}\t{t}\n')
        if not rows and not append:
            return {'error': 'sin resultados'}
        mode = 'a' if append else 'w'
        with open(QUEUE, mode) as f:
            f.writelines(n2)
        base = read_meta() if append else []
        write_meta(base + rows if append else rows)
        if not append:
            with open(CUR, 'w') as f:
                f.write('1\n')
    return {'ok': True, 'added': old, 'count': len(rows)}


def do_more():
    """pagina siguiente de la ultima busqueda (append 5 mas)."""
    q = LAST.get('q') or _load_last_q()
    if not q:
        return {'error': 'busca una frase primero'}
    LAST['q'] = q
    with STATE_LOCK:
        offset = max(len(read_meta()), len(read_entries()))
        ok, out, err = sh(YTDL, '--flat-playlist', '--no-warnings', '-J',
                          f'ytsearch{offset + 5}:{q}', timeout=50)
        if not ok:
            return {'error': err or 'no se pudo traer mas'}
        data = json.loads(out)
        rows = []
        for e in data.get('entries', [])[offset:offset + 5]:
            if not e:
                continue
            url = e.get('url') or e.get('webpage_url') or ''
            vid = url.split('v=')[-1].split('&')[0] if 'v=' in url else url
            if not vid:
                continue
            t = e.get('title') or ''
            rows.append({'vid': vid, 'title': t, 'channel': e.get('channel') or '',
                         'duration': fmt_dur(e.get('duration')),
                         'thumb': f'https://i.ytimg.com/vi/{vid}/mqdefault.jpg'})
        if not rows:
            return {'ok': True, 'count': 0, 'total': offset}
        base = read_meta()
        write_meta(base + rows)
        with open(QUEUE, 'w') as f:
            for r in base + rows:
                f.write(f"{r['vid']}\t{r['title']}\n")
    return {'ok': True, 'count': len(rows), 'total': offset + len(rows)}


def do_play(n):
    entries = read_entries()
    if not entries:
        return {'error': 'no hay lista'}
    n = max(1, int(n))
    total = len(entries)
    if n > total:
        n = total
    with open(CUR, 'w') as f:
        f.write(f'{n}\n')
    return navigate(f'https://www.youtube.com/watch?v={entries[n-1]["vid"]}&autoplay=1',
                    note=entries[n - 1]['title'])


def ensure_kiosk():
    if not os.path.exists(TVCDP):
        return
    ok, out, _ = sh(TVCDP, 'status')
    if 'OK' not in out:
        sh(TVKIOSK, timeout=60)


def _full_is(ok, out):
    return ok and out.strip().lower() in ('true', '1')


def _detect_full():
    ok, out, _ = sh(TVCDP, 'eval', '!!document.fullscreenElement', timeout=8)
    return _full_is(ok, out)


def _full_report():
    full = _detect_full()
    write_full(full)
    return full


def fullscreen_click():
    """pantalla completa: clic en el botón de YouTube (más fiable que la tecla f)."""
    # Obtener coordenadas del botón de pantalla completa
    ok, out, _ = sh(TVCDP, 'eval',
                    'JSON.stringify(document.querySelector(".ytp-fullscreen-button")?.getBoundingClientRect()||{})',
                    timeout=8)
    if ok and out.strip().startswith('{'):
        try:
            rect = json.loads(out)
            x = int(rect.get('x', 0) + rect.get('width', 0) / 2)
            y = int(rect.get('y', 0) + rect.get('height', 0) / 2)
            if x > 0 and y > 0:
                sh(TVCDP, 'mouse', str(x), str(y), timeout=8)
                time.sleep(1.0)
                return _detect_full()
        except Exception:
            pass
    # Fallback: tecla f
    sh(TVCDP, 'key', 'f')
    time.sleep(1.2)
    return _detect_full()


def read_full():
    try:
        return open(FULL).read().strip() == '1'
    except Exception:
        return False


def write_full(v):
    with open(FULL, 'w') as f:
        f.write('1' if v else '0')


def navigate(url, note=None):
    ensure_kiosk()
    sh(TVCDP, 'navigate', url)
    threading.Timer(4.0, autostart).start()
    return {'ok': True, 'title': note}


def autostart():
    ok, out, _ = sh(TVCDP, 'eval',
                    'document.querySelector("video")?document.querySelector("video").paused:false',
                    timeout=10)
    if _full_is(ok, out):
        sh(TVCDP, 'key', 'Space')
    if not read_full():
        return
    for _ in range(8):
        if fullscreen_click():
            write_full(True)
            return
        time.sleep(2.0)
    write_full(False)


def do_cmd(c, payload=None):
    if c == 'start':
        ok, out, err = sh(TVKIOSK, timeout=60)
        return {'ok': ok, 'msg': out or err}
    if c == 'quit':
        ok, out, err = sh(TVCDP, 'close')
        return {'ok': ok, 'msg': out or err}
    keymap = {'pause': 'Space', 'vol+': 'ArrowUp', 'vol-': 'ArrowDown',
              'next': 'End', 'prev': 'Home'}
    if c == 'full':
        fullscreen_click()
        full = _full_report()
        return {'ok': True, 'msg': 'pantalla completa ' + ('activada' if full else 'desactivada')}
    if c in keymap:
        ok, out, err = sh(TVCDP, 'key', keymap[c])
        return {'ok': ok, 'msg': out or err}
    return {'error': f'comando desconocido: {c}'}


