        background:#1e1e1e; color:#eee; font-size:15px; }
  .sec h2 { font-size:14px; color:#999; margin:16px 0 8px; font-weight:400; text-transform:uppercase; letter-spacing:.5px; }
  .item { display:flex; gap:10px; align-items:center; padding:8px 10px; border-radius:10px; cursor:pointer; }
  .item:hover { background:#222; }
  .item.cur { background:#2e2e2e; }
  .item img { width:120px; height:68px; object-fit:cover; border-radius:6px; flex:none; }
  .item .info { flex:1; min-width:0; }
  .item .t { font-size:14px; line-height:1.25; }
  .item .m { font-size:12px; color:#999; margin-top:3px; }
  .item.cur .t { color:#fff; }
  .badge { display:inline-block; font-size:10px; color:#ddd; background:#c4302b; border-radius:5px; padding:1px 5px; margin-left:6px; vertical-align:2px; }
  .band { border-top:1px solid #222; margin-top:8px; }
  .band button { background:none; color:#aaa; font-size:13px; padding:10px; border-radius:8px; }
</style></head><body>
<div class="wrap">
  <h1>YouTube en los TVs</h1>
  <div class="status"><span class="dot" id="dot"></span><span id="sttxt">comprobando...</span></div>

  <div class="grid">
    <button class="wide" onclick="cmd('pause')">⏸ Pausa</button>
    <button onclick="cmd('vol+')">🔊 +</button>
    <button onclick="cmd('vol-')">🔉 -</button>
    <button onclick="cmd('next')">⏭ Saltar al final</button>
    <button class="wide" onclick="cmd('full')">⛶ Pantalla completa</button>
    <button class="acc" onclick="cmd('quit')">✕ Cerrar kiosko</button>
  </div>

  <div class="search">
    <input id="q" type="text" placeholder="Buscar en YouTube..."
           onkeydown="if(event.key==='Enter')search()">
    <button onclick="search()">Buscar</button>
  </div>

  <div class="sec"><h2>Resultados / lista (clic en uno para reproducirlo)</h2>
    <div id="res"></div>
    <div class="band" id="band"><button onclick="more()">+ mas resultados</button></div>
  </div>
</div>
<script>
let entries = [];
let searching = false;
function api(p, body) { return fetch(p, {method:'POST', headers:{'Content-Type':'application/json'},
                     body: JSON.stringify(body||{})}).then(r=>r.json()); }
function cmd(c){ api('/api/cmd',{c}).then(refresh).catch(()=>refresh()); }
function search(){ const q=document.getElementById('q').value.trim();
  if(!q) return;
  searching=true;
  entries=[];
  render();
  api('/api/search',{q})
    .then(()=>{})
    .catch(()=>{})
    .finally(()=>{ searching=false; refresh(); }); }
function more(){ api('/api/more',{}).then(refresh).catch(()=>refresh()); }
function play(n){ api('/api/play',{n}).then(refresh).catch(()=>refresh()); }
function render(){
  document.getElementById('res').innerHTML = entries.map(e=>
    `<div class="item ${e.cur?'cur':''}" onclick="play(${e.n})">
       <img src="${e.thumb}" loading="lazy" alt="">
       <div class="info">
         <div class="t">${e.title}${e.cur?'<span class="badge">▶ suena</span>':''}</div>
         <div class="m">${e.channel}${e.duration?' · '+e.duration:''}</div>
       </div>
     </div>`
  ).join('') || (searching
      ? '<div class="item"><div class="info"><div class="t">buscando...</div></div></div>'
      : '<div class="item"><div class="info"><div class="t">(vacío: busca algo arriba)</div></div></div>');
}
function refresh(){
  if(searching) return;
  fetch('/api/state').then(r=>r.json()).then(s=>{
    const curN = s.cur;
    entries = s.entries.map((e,i)=>({...e, n:i+1, cur:(i+1)===curN}));
    const dot=document.getElementById('dot'), tx=document.getElementById('sttxt');
    dot.className='dot'+(s.on?' on':'');
    tx.textContent = s.on ? ('kiosko activo · '+(s.title||s.url||'...')+(s.full?' · pantalla completa':''))
                          : 'kiosko apagado (pulsa el boton de la TV del escritorio y refresca)';
    render();
  }).catch(()=>{});
}
setInterval(refresh, 4000); refresh();
</script></body></html>
"""


class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _json(self, obj, code=200):
        data = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path in ('/', '/index.html'):
            data = INDEX.encode()
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.send_header('Content-Length', str(len(data)))
            self.end_headers()
            self.wfile.write(data)
        elif self.path == '/api/state':
            self._json(state())
        else:
            self._json({'error': 'not found'}, 404)

    def do_POST(self):
        try:
            length = int(self.headers.get('Content-Length', 0))
            body = json.loads(self.rfile.read(length) or b'{}') if length else {}
        except Exception:
            body = {}
        if self.path == '/api/cmd':
            self._json(do_cmd(body.get('c', ''), body))
        elif self.path == '/api/search':
            self._json(do_search(body.get('q', ''), append=False))
        elif self.path == '/api/more':
            self._json(do_more())
        elif self.path == '/api/add':
            self._json(do_search(body.get('q', ''), append=True))
        elif self.path == '/api/play':
            self._json(do_play(body.get('n', 1)))
        elif self.path == '/api/nav':
            self._json(navigate(body.get('url', '')))
        else:
            self._json({'error': 'not found'}, 404)


def main():
    port = 8765
    srv = ThreadingHTTPServer(('127.0.0.1', port), H)
    print(f'panel de TVs en http://127.0.0.1:{port}')
    srv.serve_forever()


if __name__ == '__main__':
    main()