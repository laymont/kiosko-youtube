<script>
let entries = [];
let favorites = [];
let searching = false;

function api(p, body) {
  return fetch(p, {method:'POST', headers:{'Content-Type':'application/json'},
                   body: JSON.stringify(body||{})}).then(r=>r.json());
}

function cmd(c){ api('/api/cmd',{c}).then(refresh).catch(()=>refresh()); }

function search(){
  const q=document.getElementById('q').value.trim();
  if(!q) return;
  searching=true;
  entries=[];
  render();
  api('/api/search',{q})
    .then(r=>{ if(r.error) alert(r.error); })
    .catch(e=>alert('Error: '+e))
    .finally(()=>{ searching=false; refresh(); });
}

function more(){ api('/api/more',{}).then(r=>{ if(r.error) alert(r.error); refresh(); }).catch(()=>refresh()); }

function isFavorite(vid) { return favorites.some(f => f.vid === vid); }

async function toggleFavorite(vid, title) {
  if (isFavorite(vid)) {
    await api('/api/favorites/remove', {vid});
  } else {
    await api('/api/favorites/add', {vid, title});
  }
  refresh();
}

function playVid(vid) {
  // Buscar el índice en la lista actual y reproducir
  const idx = entries.findIndex(e => e.vid === vid);
  if (idx >= 0) play(idx + 1);
  else {
    // Si es favorito, navegar directamente
    api('/api/nav', {url: 'https://www.youtube.com/watch?v=' + vid + '&autoplay=1'});
  }
}

function play(n){ api('/api/play',{n}).then(refresh).catch(()=>refresh()); }

function render(){
  const res = document.getElementById('res');
  if (searching) {
    res.innerHTML = '<div class="empty">Buscando...</div>';
    return;
  }
  if (!entries.length) {
    res.innerHTML = '<div class="empty">(vacío: busca algo arriba o usa la terminal: tvs "frase")</div>';
    return;
  }
  res.innerHTML = entries.map(e=>{
    const fav = isFavorite(e.vid) ? 'active' : '';
    return `<div class="item ${e.cur?'cur':''}" onclick="play(${e.n})">
      <img src="${e.thumb}" loading="lazy" alt="">
      <div class="info">
        <div class="t">${e.title}${e.cur?'<span class="badge">▶ sonando</span>':''}</div>
        <div class="m">${e.channel||''}${e.duration?' · '+e.duration:''}</div>
      </div>
      <button class="fav-btn ${fav}" onclick="event.stopPropagation();toggleFavorite('${e.vid}','${(e.title||'').replace(/'/g,"\\'")}')" title="Favorito">★</button>
    </div>`;
  }).join('');
}

function renderFavorites(){
  const favList = document.getElementById('fav-list');
  if (!favorites.length) {
    favList.innerHTML = '<div class="empty">Sin favoritos todavía</div>';
    return;
  }
  favList.innerHTML = favorites.map(f=>`
    <div class="item" onclick="playVid('${f.vid}')">
      <img src="${f.thumb || 'https://i.ytimg.com/vi/'+f.vid+'/mqdefault.jpg'}" loading="lazy" alt="">
      <div class="info">
        <div class="t">${f.title || f.vid}</div>
      </div>
      <button class="fav-btn active" onclick="event.stopPropagation();toggleFavorite('${f.vid}')" title="Quitar">★</button>
    </div>
  `).join('');
}

function updateStats(s){
  document.getElementById('stat-state').textContent = s.on ? 'Activo' : 'Apagado';
  document.getElementById('stat-state').className = 'value ' + (s.on ? 'ok' : 'warn');
  document.getElementById('stat-play').textContent = s.playback || (s.on ? '...' : '-');
  document.getElementById('stat-play').className = 'value ' + (s.playback === 'playing' ? 'ok' : (s.playback === 'paused' ? 'warn' : ''));
  document.getElementById('stat-queue').textContent = s.total ? `${s.cur}/${s.total}` : '0';
  document.getElementById('stat-favs').textContent = s.favorites_count || 0;
}

function refresh(){
  if(searching) return;
  fetch('/api/state').then(r=>r.json()).then(s=>{
    favorites = s.favorites || [];
    const curN = s.cur;
    entries = s.entries.map((e,i)=>({...e, n:i+1, cur:(i+1)===curN}));
    const dot=document.getElementById('dot'), tx=document.getElementById('sttxt');
    dot.className='dot'+(s.on?' on':' off');
    tx.textContent = s.on
      ? ('Kiosko activo · '+(s.title||s.url||'...')+(s.full?' · pantalla completa':'')+(s.playback?' · '+s.playback:''))
      : 'Kiosko apagado (pulsa "Encender kiosko" o el botón de la TV del escritorio)';
    updateStats(s);
    render();
    renderFavorites();
  }).catch(()=>{});
}

setInterval(refresh, 3000);
refresh();
</script></body></html>
"""


class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _json(self, obj, code=200):
        data = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path in ('/', '/index.html'):
            data = INDEX.encode()
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.send_header('Content-Length', str(len(data)))
            self.end_headers()
            self.wfile.write(data)
        elif self.path == '/api/state':
            self._json(state())
        else:
            self._json({'error': 'not found'}, 404)

    def do_POST(self):
        try:
            length = int(self.headers.get('Content-Length', 0))
            body = json.loads(self.rfile.read(length) or b'{}') if length else {}
        except Exception:
            body = {}
        if self.path == '/api/cmd':
            self._json(do_cmd(body.get('c', ''), body))
        elif self.path == '/api/search':
            self._json(do_search(body.get('q', ''), append=False))
        elif self.path == '/api/more':
            self._json(do_more())
        elif self.path == '/api/add':
            self._json(do_search(body.get('q', ''), append=True))
        elif self.path == '/api/play':
            self._json(do_play(body.get('n', 1)))
        elif self.path == '/api/nav':
            self._json(navigate(body.get('url', '')))
        elif self.path == '/api/favorites/add':
            vid = body.get('vid', '')
            title = body.get('title', '')
            if not vid:
                self._json({'error': 'vid requerido'})
            else:
                result = do_add_favorite(vid, title)
                self._json(result, 201 if result.get('ok') else 400)
        elif self.path == '/api/favorites/remove':
            vid = body.get('vid', '')
            if not vid:
                self._json({'error': 'vid requerido'})
            else:
                result = do_remove_favorite(vid)
                self._json(result, 204 if result.get('ok') else 400)
        elif self.path == '/api/favorites':
            self._json({'ok': True, 'favorites': read_favorites()})
        else:
            self._json({'error': 'not found'}, 404)


def main():
    port = 8765
    srv = ThreadingHTTPServer(('127.0.0.1', port), H)
    print(f'panel de TVs en http://127.0.0.1:{port}')
    srv.serve_forever()


if __name__ == '__main__':
    main()